# ==============================================================================
# Saans — Environment Variables Template
# PLACEHOLDERS ONLY — Never commit actual secrets or production keys.
# ==============================================================================

# Node.js + Express API Backend Configuration
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/saans
ML_SERVICE_URL=http://localhost:8000

# AWS General Settings
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=placeholder_aws_access_key
AWS_SECRET_ACCESS_KEY=placeholder_aws_secret_key

# AWS Authentication & User Management (Amazon Cognito)
COGNITO_USER_POOL_ID=ap-south-1_placeholder_user_pool
COGNITO_CLIENT_ID=placeholder_cognito_client_id

# AWS Time-Series & Storage Telemetry
TIMESTREAM_DATABASE=saans_telemetry
TIMESTREAM_TABLE=ambient_readings
S3_DATA_LAKE_BUCKET=saans-data-lake-placeholder

# AWS Messaging & Alerts (SNS / SES / Pinpoint)
SNS_TOPIC_ARN_ALERTS=arn:aws:sns:ap-south-1:123456789012:saans-bad-air-alerts
SES_SENDER_EMAIL=alerts@saans.example.com
PINPOINT_APP_ID=placeholder_pinpoint_app_id

# Amazon Bedrock
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# ML Microservice Configuration (Python + Flask)
ML_SERVICE_PORT=8000
FLASK_ENV=development

# Frontend Client Configuration (React PWA)
REACT_APP_API_BASE_URL=http://localhost:5000/api
REACT_APP_AWS_REGION=ap-south-1
REACT_APP_COGNITO_USER_POOL_ID=ap-south-1_placeholder_user_pool
REACT_APP_COGNITO_WEB_CLIENT_ID=placeholder_cognito_client_id
